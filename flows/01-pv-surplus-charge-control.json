    {
        "id": "0d525ea750106767",
        "type": "function",
        "z": "eb5bb401c7b92a3e",
        "name": "DESS_control",
        "func": "// Şu anki saati al\nvar date = new Date();\nvar hour = date.getHours();\n\n// KURAL: Gündüz Güneş Saatleri (Örn: 08:00 ile 17:00 arası)\nif (hour >= 8 && hour < 17) {\n    // 0 = DESS'i KAPAT (Off modu). \n    // Sistem standart ESS'ye döner ve bizim \"Akıllı Vana\" (100 Amper kuralı) engelsiz çalışır.\n    msg.payload = 0; \n} \n// KURAL: Gece Saatleri (17:00'den sabah 08:00'e kadar)\nelse {\n    // 1 = DESS AUTO modu. \n    // Güneş battı, yapay zeka devralıp gece ticaretini/optimizasyonunu kendi yönetsin.\n    msg.payload = 1; \n}\n\nreturn msg;",

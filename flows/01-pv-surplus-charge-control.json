    {
        "id": "471466f2e5f24e6e",
        "type": "function",
        "z": "eb5bb401c7b92a3e",
        "name": "weather_condition",
        "func": "// Eğer API'den veri başarıyla gelmişse\nif (msg.payload && msg.payload.current_weather) {\n    \n    // WMO (Dünya Meteoroloji Örgütü) hava durum kodunu al\n    var wmo_code = msg.payload.current_weather.weathercode;\n    var is_cloudy = false;\n    \n    // KOD MANTIĞI:\n    // 0: Açık, 1: Çoğunlukla Açık, 2: Parçalı Bulutlu (Paneller iyi üretir)\n    // 3: Tam Kapalı / Çok Bulutlu (Üretim düşer)\n    // 45 ve üzeri: Sis, Yağmur, Kar, Fırtına vb. (Üretim çöker)\n    \n    if (wmo_code === 3 || wmo_code >= 45) {\n        // Hava kötü, sistemi uyar!\n        is_cloudy = true;\n    } else {\n        // Hava güneşli veya panel için yeterli\n        is_cloudy = false;\n    }\n    \n    // Bu sonucu hafızaya kazı (Sizin \"Akıllı Vana\" düğümünüz burayı okuyacak)\n    flow.set('is_cloudy', is_cloudy);\n    \n    // Debug ekranında durumu rahatça okuyabilmeniz için mesajı düzenle\n    msg.payload = \"Geyikli WMO Kodu: \" + wmo_code + \" | Batarya Kurtarma Modu (Bulut): \" + is_cloudy;\n    return msg;\n    \n} else {\n    // İnternet koparsa veya API yanıt vermezse varsayılan olarak güneşli (false) kabul et\n    flow.set('is_cloudy', false);\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

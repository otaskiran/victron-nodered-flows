    {
        "id": "457591ed8d676a80",
        "type": "function",
        "z": "eb5bb401c7b92a3e",
        "name": "Calculate MaxChargeCurrent",
        "func": "// Arka planda toplanan verileri al\nvar grid_w = flow.get('grid_w') || 0;\nvar batt_a = flow.get('batt_a') || 0;\nvar is_cloudy = flow.get('is_cloudy') || false;\n\n// 1. Şebekeye satılan güç (Victron'da eksi(-) olan bu değeri hesap için pozitife çeviriyoruz)\nvar export_w = 0;\nif (grid_w < 0) {\n    export_w = Math.abs(grid_w); \n}\n\n// 2. Bataryaya giden şarj gücü (Pozitif akımı Watt'a çeviriyoruz, ortalama 52V kabul ederek)\nvar charge_w = 0;\nif (batt_a > 0) {\n    charge_w = batt_a * 52;\n}\n\n// 3. O anki GERÇEK GÜNEŞ FAZLALIĞI = Şebekeye giden + Bataryanın çektiği\nvar total_surplus_w = export_w + charge_w;\n\nvar limit = 0;\n\n// KURAL 1: Hava bulutluysa direkt kurtarma modu\nif (is_cloudy === true) {\n    limit = 100;\n} \n// KURAL 2: Matematiksel Denge\nelse {\n    // Hedefimiz şebekeye yaklaşık 6800W satmak. Kalanı bataryanın hakkıdır.\n    var available_for_battery_w = total_surplus_w - 6800;\n    \n    // Eğer şebekeyi 6800W doyurduktan sonra elimizde güç kalıyorsa:\n    if (available_for_battery_w > 0) {\n        limit = available_for_battery_w / 52; // Çıkan Watt'ı tekrar Amper'e (A) çevirip vanayı ayarla\n    } else {\n        limit = 0; // Şebeke henüz 6800'e ulaşmadı, bataryaya geçiş yok!\n    }\n}\n\n// Güvenlik sınırları\nif (limit < 0) limit = 0;\nif (limit > 100) limit = 100; \n\n// Küsüratlı rakamları (örn: 12.45A) yuvarla ve Victron DVCC'ye gönder\nmsg.payload = Math.round(limit);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
